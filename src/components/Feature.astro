---
// A single featured photo: the hero image of an era or a member. Remote images hotlink the original with a credit link.
interface Img { member: string; kind: 'local' | 'remote'; src?: string; remote?: string; pageUrl: string | null; credit: string | null; width: number | null; height: number | null; license?: string }
const { img, alt, eager = false } = Astro.props as { img: Img; alt: string; eager?: boolean };
const base = import.meta.env.BASE_URL;
const w = img.width ?? 3, h = img.height ?? 4;
const src = img.kind === 'local' ? base + img.src : img.remote;
---
<figure class="feature" style={`--ar:${w}/${h}`}>
  <img src={src} alt={alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" />
  <figcaption>{img.pageUrl ? <a href={img.pageUrl} target="_blank" rel="noopener">{img.credit ?? 'source'}</a> : <span>{img.credit ?? ''}{img.license ? `, ${img.license}` : ''}</span>}</figcaption>
</figure>
<style>
  .feature{margin:0;position:relative;border-radius:8px;overflow:hidden;background:var(--surface);box-shadow:0 40px 90px -40px rgba(0,0,0,.8),inset 0 0 0 1px var(--line)}
  .feature img{display:block;width:100%;height:100%;aspect-ratio:var(--ar);object-fit:cover}
  figcaption{position:absolute;left:0;right:0;bottom:0;padding:10px 14px;font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.75);background:linear-gradient(transparent,rgba(0,0,0,.55))}
  figcaption a{color:inherit;text-decoration:underline;text-underline-offset:2px}
</style>
