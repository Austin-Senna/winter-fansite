---
// A single featured photo: the hero image of an era or a member. Remote images hotlink the original with a credit link.
import { pinVariant, pinSrcset, isPin } from '@/lib/pin';
interface Img { member: string; kind: 'local' | 'remote'; src?: string; remote?: string; variants?: { w480: string; w960: string }; pageUrl: string | null; credit: string | null; width: number | null; height: number | null; license?: string }
const { img, alt, eager = false } = Astro.props as { img: Img; alt: string; eager?: boolean };
const base = import.meta.env.BASE_URL;
const w = img.width ?? 3, h = img.height ?? 4;
// Cover cards are 3:4. Remote pins load Pinterest's 1200px JPEG variant (the original can be 10 MB+) with the original as fallback.
const src = img.kind === 'local' ? base + img.src : (isPin(img.remote) ? pinVariant(img.remote!, 1200) : img.remote);
const srcset = img.kind === 'local' ? (img.variants ? `${base}${img.variants.w480} 480w, ${base}${img.variants.w960} 960w, ${base}${img.src} 1600w` : undefined) : (isPin(img.remote) ? pinSrcset(img.remote!, [736, 1200]) : undefined);
const sizes = '(max-width: 900px) 70vw, 34vw';
---
<figure class="feature">
  <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" data-orig={img.kind === 'remote' ? img.remote : undefined} onerror="if(this.dataset.orig&&this.src!==this.dataset.orig){this.removeAttribute('srcset');this.src=this.dataset.orig}" />
  <figcaption>{img.pageUrl ? <a href={img.pageUrl} target="_blank" rel="noopener">{img.credit ?? 'source'}</a> : <span>{img.credit ?? ''}{img.license ? `, ${img.license}` : ''}</span>}</figcaption>
</figure>
<style>
  .feature{margin:0;position:relative;width:100%;aspect-ratio:3/4;border-radius:8px;overflow:hidden;background:var(--surface);box-shadow:0 40px 90px -40px rgba(0,0,0,.8),inset 0 0 0 1px var(--line)}
  .feature img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 22%}
  figcaption{position:absolute;left:0;right:0;bottom:0;padding:10px 14px;font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.75);background:linear-gradient(transparent,rgba(0,0,0,.55))}
  figcaption a{color:inherit;text-decoration:underline;text-underline-offset:2px}
</style>
