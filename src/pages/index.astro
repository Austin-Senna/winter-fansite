---
import Base from '@/layouts/Base.astro';
import Timeline from '@/components/Timeline.astro';
import { MAIN_ERAS, OTHER_RELEASES } from '@/data/eras';
import { getCollection } from 'astro:content';
import { COPY } from '@/data/copy';
const entries = await getCollection('eras');
const items = MAIN_ERAS().map(era => { const c = entries.find(x => x.data.slug === era.slug)?.data; const image = c?.featured?.group ?? c?.featured?.winter ?? c?.images.group[0] ?? c?.images.winter[0]; return { era, image }; });
const base = import.meta.env.BASE_URL;
---
<Base title="aespa, by era" description="Fan-made aespa site, Winter first. Every era with its photos, videos, music and story.">
  <section class="hero">
    <h1 class="chrome" data-decode>aespa</h1>
    <p class="kicker" data-synk>{COPY.home.kicker}</p>
  </section>
  <Timeline items={items} />
  <section class="sec" aria-labelledby="other-h">
    <h2 id="other-h">Other releases</h2>
    <ul class="other">{OTHER_RELEASES().map(e => <li><a href={`${base}era/${e.slug}/`}><b>{e.title}</b><small>{e.releaseDate.replaceAll('-', '.')} · {e.type}</small></a></li>)}</ul>
  </section>
  <section class="sec"><p class="lede">Fan-made. Not affiliated with SM Entertainment. <a href={`${base}about/`}>Credits and sources</a>.</p></section>
</Base>
<style>
  .hero{min-height:70svh;display:grid;align-content:end;padding:0 var(--gutter) clamp(24px,5vh,56px)}
  h1{margin:0;font-family:var(--display);font-weight:900;text-transform:uppercase;letter-spacing:-.02em;font-size:clamp(96px,24vw,360px);line-height:.86}
  .other{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px 24px}
  .other a{text-decoration:none;color:inherit;display:grid;gap:2px;border-top:1px solid var(--line);padding-top:10px}
  .other b{font-family:var(--display);font-weight:800;text-transform:uppercase;letter-spacing:.04em;font-size:18px}
  .other small{font-family:var(--mono);font-size:11px;color:var(--ink-dim)}
  .other a:hover b{color:var(--era-b)}
  .kicker{font-family:var(--serif);font-style:italic;font-size:clamp(22px,2.6vw,36px);margin:.3em 0 0;color:var(--ink-dim)}
</style>
<script>
  import { initMotion } from '@/scripts/motion';
  document.addEventListener('astro:page-load', initMotion);
</script>
